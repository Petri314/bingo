# Plantilla de variables de entorno — copia este archivo a .env.local
#
#   cp .env.example .env.local
#
# .env.local está en .gitignore: nunca debe subirse al repositorio.
# En producción (Vercel) estas variables se configuran en
# Project → Settings → Environment Variables, no en el repo.

# PIN de 4 dígitos que pide el panel de admin (api/login.js)
ADMIN_PIN=

# Clave larga y aleatoria para firmar los tokens JWT (api/login.js)
# Genera una con: openssl rand -hex 32
JWT_SECRET=
